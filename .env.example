# Author: Bradley R. Kinnard
# ironroot environment configuration

# api
IRONROOT_HOST=0.0.0.0
IRONROOT_PORT=8000
IRONROOT_DEBUG=false
IRONROOT_LOG_LEVEL=INFO

# postgres
IRONROOT_DB_HOST=localhost
IRONROOT_DB_PORT=5432
IRONROOT_DB_NAME=ironroot
IRONROOT_DB_USER=ironroot
IRONROOT_DB_PASSWORD=changeme

# redis
IRONROOT_REDIS_HOST=localhost
IRONROOT_REDIS_PORT=6379
IRONROOT_REDIS_DB=0

# artifact store (local filesystem or s3-compatible)
IRONROOT_ARTIFACT_STORE=local
IRONROOT_ARTIFACT_PATH=./artifacts

# optional s3
# IRONROOT_S3_ENDPOINT=
# IRONROOT_S3_BUCKET=
# IRONROOT_S3_ACCESS_KEY=
# IRONROOT_S3_SECRET_KEY=
